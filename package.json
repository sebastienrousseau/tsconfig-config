{
  "name": "@sebastienrousseau/tsconfig-config",
  "version": "0.0.7",
  "description": "Shared TypeScript compiler configuration rules adhering to modern 2026 standards",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/tsconfig-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/tsconfig-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/tsconfig-config/issues"
  },
  "keywords": [
    "tsconfig",
    "typescript",
    "compiler-options",
    "tsc"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./base.json": "./base.json",
    "./node.json": "./node.json",
    "./web.json": "./web.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "base.json",
    "node.json",
    "web.json",
    "tsconfig-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/conformance.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh",
    "test:conformance": "node --test tests/conformance.test.js",
    "fuzz": "node fuzz/fuzz_config.js"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@sebastienrousseau/config-kit": "^0.0.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "configKit": {
    "shape": "object",
    "presets": [
      "base.json",
      "node.json",
      "web.json"
    ],
    "validate": "typescript-tsconfig"
  }
}
