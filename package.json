{
  "name": "@sebastienrousseau/tsconfig-config",
  "version": "1.0.0",
  "description": "Shared TypeScript compiler configuration rules adhering to modern 2026 standards",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "ISC",
  "homepage": "https://github.com/sebastienrousseau/tsconfig-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/tsconfig-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/tsconfig-config/issues"
  },
  "keywords": [
    "tsconfig",
    "typescript",
    "compiler-options",
    "tsc"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./base.json": "./base.json",
    "./node.json": "./node.json",
    "./web.json": "./web.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "base.json",
    "node.json",
    "web.json",
    "tsconfig-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/test.js",
    "lint": "node test/test.js"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
